        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "order_id",
          "customer_id"
        ],
        "title": "OrderInput"
      },
      "PolicyAnswerResponse": {
        "properties": {
          "question": {
            "type": "string",
