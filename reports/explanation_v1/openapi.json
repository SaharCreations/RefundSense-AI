          },
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "refund_amount_minor": {
            "type": "integer",
            "title": "Refund Amount Minor"
          },
          "restocking_fee_minor": {
            "type": "integer",
            "title": "Restocking Fee Minor"
          },
          "currency": {
            "type": "string",
