          },
          "answer": {
            "$ref": "#/components/schemas/ExplanationResponse"
          },
          "selector": {
            "additionalProperties": true,
            "type": "object",
            "title": "Selector"
          }
        },
        "type": "object",
        "required": [
          "question",
          "as_of",
          "collection_id",
          "retrieval_scope",
          "answer",
          "selector"
