            "$ref": "#/components/schemas/ExplanationResponse"
          },
          "selector": {
            "additionalProperties": true,
            "type": "object",
            "title": "Selector"
          }
        },
        "type": "object",
        "required": [
          "authoritative_assessment",
          "deterministic_summary",
          "policy_explanation",
          "selector"
        ],
        "title": "AssessmentExplanationResponse"
      },
      "AssessmentResponse": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "eligible",
              "ineligible",
              "review"
            ],
            "title": "Decision"
          },
          "reason_code": {
            "type": "string",
            "title": "Reason Code"
          },
          "refund_amount_minor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refund Amount Minor"
          },
          "restocking_fee_minor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Restocking Fee Minor"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "candidate_payload": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidate Payload"
          },
          "assessment_only": {
            "type": "boolean",
            "title": "Assessment Only"
          },
          "execution_allowed": {
            "type": "boolean",
            "title": "Execution Allowed"
          },
          "human_approval_required_for_execution": {
            "type": "boolean",
            "title": "Human Approval Required For Execution"
          },
          "rules_version": {
            "type": "string",
            "title": "Rules Version"
          },
          "ruleset_fingerprint": {
            "type": "string",
            "title": "Ruleset Fingerprint"
          },
          "conventions": {
            "additionalProperties": true,
            "type": "object",
            "title": "Conventions"
          },
          "citations": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Citations"
          },
          "snapshot": {
            "additionalProperties": true,
            "type": "object",
            "title": "Snapshot"
          }
        },
        "type": "object",
        "required": [
          "decision",
          "reason_code",
          "refund_amount_minor",
          "restocking_fee_minor",
          "currency",
          "candidate_payload",
          "assessment_only",
          "execution_allowed",
          "human_approval_required_for_execution",
          "rules_version",
          "ruleset_fingerprint",
          "conventions",
          "citations",
          "snapshot"
        ],
        "title": "AssessmentResponse"
      },
      "BlockedResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "assessment_blocked",
            "title": "Status"
          },
          "assessment": {
            "$ref": "#/components/schemas/AssessmentResponse"
          }
        },
        "type": "object",
        "required": [
          "status",
          "assessment"
        ],
        "title": "BlockedResponse"
      },
      "Decision": {
        "properties": {
          "approved": {
            "type": "boolean",
            "title": "Approved"
          },
          "payload_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Payload Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "approved",
          "payload_sha256"
        ],
        "title": "Decision"
      },
      "EvidenceResponse": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "scope": {
            "type": "string",
            "const": "current",
            "title": "Scope"
          },
          "as_of": {
            "type": "string",
            "title": "As Of"
          },
          "collection_id": {
            "type": "string",
            "title": "Collection Id"
          },
          "retrieved": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Retrieved"
          },
          "evidence_only": {
            "type": "boolean",
            "title": "Evidence Only"
          }
        },
        "type": "object",
        "required": [
          "question",
          "scope",
          "as_of",
          "collection_id",
          "retrieved",
          "evidence_only"
        ],
        "title": "EvidenceResponse"
      },
      "ExecutionPayload": {
        "properties": {
          "execution_target": {
            "type": "string",
            "const": "demo_ledger",
            "title": "Execution Target"
          },
          "idempotency_key": {
            "type": "string",
            "title": "Idempotency Key"
          },
          "refund": {
            "$ref": "#/components/schemas/RefundPayload"
          }
        },
        "type": "object",
        "required": [
          "execution_target",
          "idempotency_key",
          "refund"
        ],
        "title": "ExecutionPayload"
      },
      "ExplanationResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "abstain"
            ],
            "title": "Status"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "citations": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Citations"
          },
          "abstention_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abstention Reason"
          },
          "human_review_required": {
            "type": "boolean",
            "title": "Human Review Required"
          },
          "explanation_version": {
            "type": "string",
            "title": "Explanation Version"
          },
          "execution_allowed": {
            "type": "boolean",
            "const": false,
            "title": "Execution Allowed"
          },
          "evidence_is_untrusted_reference": {
            "type": "boolean",
            "title": "Evidence Is Untrusted Reference"
          }
        },
        "type": "object",
        "required": [
          "status",
          "explanation",
          "citations",
          "abstention_reason",
          "human_review_required",
          "explanation_version",
          "execution_allowed",
          "evidence_is_untrusted_reference"
        ],
        "title": "ExplanationResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
