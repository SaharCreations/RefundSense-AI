# Set this in your shell. The CLI does not silently load .env files.
# Use a dedicated local development database with the vector extension installed.
DATABASE_URL=postgresql://refundguard:CHANGE_ME@localhost:5432/refundguard
FASTEMBED_CACHE_PATH=.cache/fastembed

# API paths (optional overrides); run from the project root by default.
REFUNDGUARD_DATA_DIR=data
REFUNDGUARD_RULES_CONFIG=config/demo_ruleset.json
# Set only after downloading/verifying the pinned model and ingesting the corpus.
REFUNDGUARD_MODEL_DIR=.cache/model
# Account provisioning prompts privately; no default passwords/tokens are supplied.

# Optional local explanation model: explicit download, no API auto-download.
REFUNDGUARD_LLM_MODEL=.cache/llm/qwen2.5-1.5b-instruct-q4_k_m.gguf
REFUNDGUARD_LLM_LOCK=llm.lock.json
# Required before ONNX Runtime initialization; package also enforces this.
ORT_DISABLE_TELEMETRY=1
